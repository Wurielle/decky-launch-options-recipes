[
  {
    "name": "OptiScaler",
    "launchOptions": [
      {
        "id": "optiscaler",
        "group": "OptiScaler",
        "name": "OptiScaler",
        "on": "~/fgmod/fgmod %command%",
        "off": "~/fgmod/fgmod-uninstaller.sh %command%",
        "enableGlobally": false
      },
      {
        "id": "optiscaler-upscalers-dx11-fsr4",
        "group": "OptiScaler",
        "name": "OptiScaler Dx11 FSR4",
        "on": "OptiScaler_Upscalers_Dx11Upscaler=fsr31_12",
        "off": "",
        "enableGlobally": true
      },
      {
        "id": "optiscaler-upscalers-dx12-fsr4",
        "group": "OptiScaler",
        "name": "OptiScaler Dx12 FSR4",
        "on": "OptiScaler_Upscalers_Dx12Upscaler=fsr31",
        "off": "",
        "enableGlobally": true
      }
    ]
  },
  {
    "name": "Lossless Scaling",
    "launchOptions": [
      {
        "id": "lossless-scaling",
        "name": "Lossless Scaling",
        "on": "~/lsfg %command%",
        "off": "",
        "enableGlobally": false
      }
    ]
  },
  {
    "name": "Debug",
    "launchOptions": [
      {
        "id": "optiscaler",
        "name": "OptiScaler",
        "on": "~/fgmod/fgmod %command%",
        "off": "~/fgmod/fgmod-uninstaller.sh %command%",
        "enableGlobally": false
      },
      {
        "id": "optiscaler-upscalers-dx11-fsr4",
        "name": "OptiScaler Dx11 FSR4",
        "on": "OptiScaler_Upscalers_Dx11Upscaler=fsr31_12",
        "off": "",
        "enableGlobally": true
      },
      {
        "id": "optiscaler-upscalers-dx12-fsr4",
        "name": "OptiScaler Dx12 FSR4",
        "on": "OptiScaler_Upscalers_Dx12Upscaler=fsr31",
        "off": "",
        "enableGlobally": true
      },
      {
        "id": "optiscaler-framegen",
        "name": "OptiScaler FrameGen",
        "on": "OptiScaler_FrameGen_Enabled=true",
        "off": "",
        "enableGlobally": false
      },
      {
        "id": "optiscaler-framegen-xefg",
        "name": "OptiScaler FrameGen XeFG",
        "on": "FGInput=fsrfg FGOutput=xefg",
        "off": "",
        "enableGlobally": false
      },
      {
        "id": "optiscaler-framegen-fsr",
        "name": "OptiScaler FrameGen FSR",
        "on": "FGInput=fsrfg FGOutput=fsrfg",
        "off": "",
        "enableGlobally": false
      }
    ]
  }
]
